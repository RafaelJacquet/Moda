# ====== French Flair — Moda : configuration ======
# Copiez ce fichier en `.env` puis remplissez les valeurs.
# Le fichier .env n'est JAMAIS committé (voir .gitignore).

# --- Serveur ---
PORT=3000
# "production" active les cookies Secure + exige HTTPS derrière un reverse proxy
NODE_ENV=development
# Mettre à 1 si le serveur est derrière un reverse proxy (nginx, caddy...) qui gère HTTPS
TRUST_PROXY=0
# Secret de signature des cookies de session (OBLIGATOIRE en production).
# Généré automatiquement et stocké dans data/.secret si vide en développement.
SESSION_SECRET=

# --- Authentification ---
# AUTH_OTP=0 : connexion directe avec l'email (sans code envoyé par mail)
# AUTH_OTP=1 : code OTP par email obligatoire (recommandé si le site est exposé)
AUTH_OTP=0
# Seules les adresses de ce domaine peuvent se connecter
AUTH_ALLOWED_DOMAIN=frenchflair.pro
# Durée de validité du code OTP (minutes) et de la session (jours)
OTP_TTL_MINUTES=10
SESSION_TTL_DAYS=7

# --- Envoi des emails (codes de connexion) ---
# Tant que SMTP_HOST est vide : mode développement, le code s'affiche
# dans la console du serveur au lieu d'être envoyé.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="French Flair Moda <no-reply@frenchflair.pro>"

# --- Claude (API Anthropic) ---
# Tant que la clé est vide : le générateur fonctionne en "mode démo"
# (asset de démonstration généré par Blender, sans IA).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Plafond de tokens de sortie par appel (maximum du modèle)
CLAUDE_MAX_TOKENS=128000
# Modèles par étape : le code Blender reste sur le modèle principal,
# l'enrichissement et la vérification utilisent un modèle plus rapide.
CLAUDE_MODEL_CODE=claude-opus-5-5
CLAUDE_MODEL_SPEC=claude-sonnet-5-5
CLAUDE_MODEL_VERIFY=claude-sonnet-5-5
# Nombre maximum de boucles de correction automatique d'un asset
MAX_FIX_ITERATIONS=3
# Taux de conversion USD -> EUR pour l'affichage des coûts
USD_EUR_RATE=0.86

# --- Blender (conteneur Docker, protocole blender-mcp) ---
BLENDER_MCP_HOST=127.0.0.1
BLENDER_MCP_PORT=9876
